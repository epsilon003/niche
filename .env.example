# ---- Alpaca (paper trading) ----
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_PAPER=true
# REST/data hosts (paper trading uses the same market-data host as live)
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex

# ---- Scientific agent LLM provider ----
# "openrouter" (default, free tier — see below) or "featherless" (paid, flat-rate).
LLM_PROVIDER=openrouter

# OpenRouter: sign up free at https://openrouter.ai/keys, no card required.
# Free tier: 20 req/min; 50 req/day, or 1000/day after any one-time $10+
# credit purchase (purchased credits don't expire and don't get spent by
# free-model calls). The specific free model below can rotate out — check
# https://openrouter.ai/models?max_price=0 for the current free lineup if
# classification calls start failing with a "model not found" error.
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Featherless (paid, flat-rate subscription) — only used if LLM_PROVIDER=featherless
FEATHERLESS_API_KEY=your_featherless_key
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct

# ---- ClinicalTrials.gov / openFDA ----
# ClinicalTrials.gov API v2 needs no key. openFDA works keyless but rate-limited;
# an api key raises the limit substantially.
OPENFDA_API_KEY=

# ---- Options execution (Phase 6) ----
# Safety default: true. Gates (IV rank, max-loss) still run and get logged
# either way — this only controls whether a passing trade actually submits
# a paper order, or just logs what it *would* have submitted.
EXECUTION_DRY_RUN=true
# Reject a spread if its IV rank (0-100) exceeds this — avoids buying
# premium that's already priced for an extreme move.
IV_RANK_MAX=90
# If true, a ticker with no IV history yet blocks trading entirely. If
# false (default), missing history is logged and the trade proceeds —
# otherwise nothing trades for the first ~20 days on a fresh install.
IV_RANK_REQUIRE_HISTORY=false
# Max % of account equity a single spread's net debit may risk.
MAX_LOSS_PCT=2.0

# ---- Universe ----
# Comma-separated tickers this whole pipeline watches end-to-end.
WATCHLIST=MRNA,NVAX,BNTX,SRPT,IONS

# ---- Misc ----
LOG_LEVEL=INFO
DATA_DIR=./data
